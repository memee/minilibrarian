{
  "name": "minilibrarian",
  "version": "0.2.0",
  "description": "Cross-platform minilogue xd sound library browser",
  "desktopName": "MiniLibrarian",
  "main": "src/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg zip --universal",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:win:arm64": "electron-builder --win nsis portable --arm64",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:linux:arm64": "electron-builder --linux AppImage deb --arm64"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.minilibrarian.app",
    "productName": "MiniLibrarian",
    "directories": { "output": "release" },
    "files": ["src/**/*", "package.json"],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.music" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage"], "category": "AudioVideo;Audio;", "syncDesktopName": true }
  }
}
